APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di production (hanya kirim cookie lewat HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Batas MUTLAK sejak login (menit). Berbeda dari SESSION_LIFETIME yang
# merupakan batas menganggur dan diperbarui tiap request. 0 = nonaktif.
SESSION_ABSOLUTE_LIFETIME=120

# Isi 'reverb' untuk notifikasi realtime. Nilai lain (log/null) membuat
# dashboard jatuh ke polling sesuai interval di halaman Pengaturan.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Kosongkan di lokal. Di VPS isi path reverse proxy, mis. /app
REVERB_SERVER_PATH=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_PATH="${REVERB_SERVER_PATH}"
FILESYSTEM_DISK=local #public for production
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


FONTAWESOME_API_TOKEN=

# Free API key from https://www.deepl.com/pro-api (Free plan key ends with ":fx")
DEEPL_API_KEY=

# Akun pemilik yang dibuat oleh db:seed. Ganti kata sandinya lewat
# menu Profil segera setelah login pertama.
OWNER_NAME="Portfolio Owner"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=

# Isi dengan jalur absolut bila mysqldump tidak ada di PATH (umum di aaPanel)
MYSQLDUMP_PATH=mysqldump

# Kunci enkripsi berkas backup. WAJIB terpisah dari APP_KEY.
# Hasilkan dengan: php artisan backup:key
# PERINGATAN: kehilangan kunci ini = kehilangan seluruh backup, permanen.
# Simpan salinannya di luar server.
BACKUP_ENCRYPTION_KEY=
BACKUP_TIMEOUT=600

# reCAPTCHA v3. Nilai di sini hanya cadangan; utamanya diatur dari
# dashboard pada Pengaturan > Integrasi.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
RECAPTCHA_THRESHOLD=0.5
