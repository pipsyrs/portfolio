[Unit]
Description=Laravel Reverb WebSocket Server (portfolio)
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/apiprs.my.id
ExecStart=/www/server/php/85/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=5

# journald, bukan append ke file. append: butuh file sudah writable oleh
# User= saat start, dan kegagalannya muncul sebagai exit 209/STDOUT.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portfolio-reverb

# Batas memori untuk VPS 1GB
MemoryMax=192M
LimitNOFILE=10000

[Install]
WantedBy=multi-user.target
