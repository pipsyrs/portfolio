[Unit]
Description=Laravel Queue Worker
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/portfolio
ExecStart=/www/server/php/83/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5
StandardOutput=append:/www/wwwroot/portfolio/storage/logs/queue.log
StandardError=append:/www/wwwroot/portfolio/storage/logs/queue.log

MemoryMax=128M

[Install]
WantedBy=multi-user.target
