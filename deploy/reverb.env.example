# Potongan .env produksi untuk Reverb di balik reverse proxy path /app.
# Salin ke .env di VPS, ganti domain.com dan isi kredensial hasil generate.

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Host & port yang dipakai Laravel untuk publish event -> langsung ke proses lokal
REVERB_HOST=domain.com
REVERB_PORT=443
REVERB_SCHEME=https

# Proses Reverb hanya mendengar di loopback, Nginx yang menghadap publik
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=/app

# Dibaca Vite saat build, harus cocok dengan location di Nginx
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_PATH="${REVERB_SERVER_PATH}"
